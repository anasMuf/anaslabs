# Supabase (server-only, dipakai server function)
SUPABASE_URL=https://ckgqbcgibmwqcjaideto.supabase.co
SUPABASE_SECRET_KEY=<secret key dari Project Settings -> API Keys>
WALL_ADMIN_TOKEN=<openssl rand -hex 24>

# Publishable key: aman di browser. Dibaca di server lalu dikirim ke browser saat
# runtime, supaya image hasil build CI (tanpa .env) tetap jalan.
# Dipakai untuk login dashboard (Supabase Auth).
SUPABASE_PUBLISHABLE_KEY=<publishable key dari Project Settings -> API Keys>

# Dashboard undangan: kunci penandatangan cookie sesi.
# Minimal 16 karakter, contoh: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=<openssl rand -hex 32>

# Login dashboard TIDAK memakai env. Kredensial (email + password) dibuat di
# Supabase -> Authentication -> Users. Siapa yang boleh masuk diatur oleh tabel
# `dashboard_users` (lihat supabase/migrations/0002_dashboard_users.sql).

# Blast WhatsApp (Wablas): token untuk endpoint worker /api/blast/worker.
# Buat dengan: openssl rand -hex 32
BLAST_WORKER_TOKEN=
