# Supabase (server-only, dipakai server function)
SUPABASE_URL=https://ckgqbcgibmwqcjaideto.supabase.co
SUPABASE_SECRET_KEY=<secret key dari Project Settings -> API Keys>
WALL_ADMIN_TOKEN=<openssl rand -hex 24>

# Publishable key: aman di browser. Dibaca di server lalu dikirim ke browser saat
# runtime, supaya image hasil build CI (tanpa .env) tetap jalan.
# Hanya dipakai kalau login memakai magic link.
SUPABASE_PUBLISHABLE_KEY=<publishable key dari Project Settings -> API Keys>

# Dashboard undangan
DASHBOARD_SESSION_SECRET=<openssl rand -hex 32>

# Login password (cara utama). Buat hash dengan:
#   node scripts/dashboard-password.mjs "password-panjang-anda"
# JANGAN memakai pemisah '$' di nilai ini: Vite/dotenv mengekspansi '$' di .env
# sehingga hash rusak. Skrip sudah memakai pemisah ':'.
DASHBOARD_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>
# Nama yang tampil di dashboard ("Masuk sebagai ..."). Opsional.
DASHBOARD_IDENTITY=Anas & Mila

# Login magic link (opsional, kena kuota email Supabase free ±2/jam).
# Kalau DASHBOARD_PASSWORD_HASH diset, password dipakai lebih dulu.
DASHBOARD_EMAILS=nama1@email.com,nama2@email.com
